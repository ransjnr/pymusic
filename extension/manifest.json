{
  "manifest_version": 3,
  "name": "pyMusic Downloader",
  "version": "0.1.4",
  "description": "Download music from YouTube, SoundCloud, Spotify and more — powered by pymusic-downloader.",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://127.0.0.1:6173/*"
  ],

  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "pyMusic Downloader"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://soundcloud.com/*",
        "*://open.spotify.com/*",
        "*://www.spotify.com/*",
        "*://bandcamp.com/*",
        "*://*.bandcamp.com/*"
      ],
      "js": ["content/detector.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
